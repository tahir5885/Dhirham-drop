{
  "name": "@dirhamdrop/database",
  "version": "1.0.0",
  "description": "Prisma ORM schema, client, and seed utilities for DirhamDrop",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
