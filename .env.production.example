NODE_ENV="production"
PORT=3000

# Set this to your public VPS IP or domain (e.g. https://dirhamdrop.com or http://123.45.67.89:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Random secret key for session encryption (run `openssl rand -hex 32` to generate)
NEXTAUTH_SECRET="change_me_to_a_secure_random_secret_32_characters_long"

# Database Configuration
# Default: High-performance embedded SQLite database (pre-seeded with 73 canonical products & 380 store listings)
DATABASE_URL="file:./dev.db"

# Optional: Remote or Local PostgreSQL (if migrating to Postgres)
# DATABASE_URL="postgresql://postgres:password@postgres:5432/dirhamdrop?schema=public"

# Scrapering.com Anti-Bot Engine for Real-Time Price Checks & Scraping
SCRAPERING_API_KEY="default_1nO6On_qD_SOmqBd5U5KcP805pIlC0-UYMdgD7Rez7Y"

# Affiliate Tags for UAE Retailers
AMAZON_AFFILIATE_TAG="dirhamdrop-21"
