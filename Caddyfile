# DirhamDrop Production Caddy Reverse Proxy & Automatic SSL Configuration
# Replace {$DOMAIN:localhost} with your domain (e.g. dirhamdrop.com) in your .env or run with:
# DOMAIN=yourdomain.com docker compose -f docker-compose.yml -f docker-compose.ssl.yml up -d

{$DOMAIN:localhost} {
    reverse_proxy web:3000

    # Modern compression
    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
